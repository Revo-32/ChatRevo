<UserControl x:Class="ChatRevo.Desktop.Views.AppearancePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#ECEAE6">
 <ScrollViewer x:Name="Scroll" Foreground="#ECEAE6">
  <StackPanel>
   <DockPanel Margin="0,0,0,16">
    <Button DockPanel.Dock="Right" Content="미리보기 ↗" Command="{Binding PreviewCommand}" HorizontalAlignment="Right"/>
    <TextBlock Text="화면 스타일" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
   </DockPanel>
   <Grid Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <CheckBox Content="채널명 · 시청자 수" IsChecked="{Binding ShowHeader}"/>
    <CheckBox Grid.Column="2" Content="원본 스타일" IsChecked="{Binding NativeAppearance}"/>
   </Grid>
   <Grid IsEnabled="{Binding CustomStyling}">
    <Grid.Style><Style TargetType="Grid"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style></Grid.Style>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="글자" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>
       <ComboBox x:Name="FontPicker" ItemsSource="{Binding Fonts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FontId}" MaxDropDownHeight="320"/>
       <TextBlock Text="반가워요, 오늘도 함께해요 0123" FontFamily="{Binding SampleFont}" FontSize="18" TextWrapping="Wrap" Margin="0,14,0,0"/>
       <TextBlock Text="{Binding FontAttribution}" FontSize="11" Foreground="#A6A19A" TextWrapping="Wrap"/>
       <DockPanel Margin="0,20,0,0"><TextBlock Text="크기"/><TextBlock Text="{Binding FontSize, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
       <Slider Minimum="12" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" AutomationProperties.AutomationId="FontSize"/>
       <CheckBox Content="굵은 글씨" IsChecked="{Binding Bold}"/>
       <Button Command="{Binding TextColorCommand}" Margin="0,8"><StackPanel Orientation="Horizontal"><Border Background="{Binding TextColor}" Width="14" Height="14" CornerRadius="3" Margin="0,0,10,0"/><TextBlock Text="본문 색상"/></StackPanel></Button>
       <CheckBox Content="닉네임 색상 통일" IsChecked="{Binding UniformNicknameColor}"/>
       <Button Command="{Binding NicknameColorCommand}" IsEnabled="{Binding UniformNicknameColor}" Margin="0,4,0,20"><StackPanel Orientation="Horizontal"><Border Background="{Binding NicknameColor}" Width="14" Height="14" CornerRadius="3" Margin="0,0,10,0"/><TextBlock Text="닉네임 색상"/></StackPanel></Button>
       <DockPanel><TextBlock Text="줄 간격"/><TextBlock Text="{Binding LineHeight, StringFormat={}{0:0.00}배}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
       <Slider Minimum="1.1" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding LineHeight}"/>
       <DockPanel><TextBlock Text="메시지 간격"/><TextBlock Text="{Binding MessageSpacing, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
       <Slider Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MessageSpacing}" Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
       <TextBlock Text="전체 배경" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>
       <DockPanel><TextBlock Text="불투명도"/><TextBlock Text="{Binding BackgroundOpacity, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
       <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}"/>
       <Button Command="{Binding ColorCommand}"><StackPanel Orientation="Horizontal"><Border Background="{Binding BackgroundColor}" Width="14" Height="14" CornerRadius="3" BorderBrush="#55514B" BorderThickness="1" Margin="0,0,10,0"/><TextBlock Text="배경 색상"/></StackPanel></Button>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
       <TextBlock Text="새 채팅 효과" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>
       <ComboBox x:Name="AnimationPicker" ItemsSource="{Binding Animations}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MessageAnimation}"/>
       <StackPanel IsEnabled="{Binding AnimationEnabled}" Margin="0,18,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style></StackPanel.Style>
        <DockPanel><TextBlock Text="재생 시간"/><TextBlock Text="{Binding AnimationDuration, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
        <Slider Minimum="100" Maximum="800" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding AnimationDuration}"/>
        <DockPanel><TextBlock Text="움직임 크기"/><TextBlock Text="{Binding AnimationDistance, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
        <Slider Minimum="4" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AnimationDistance}" Margin="0,12,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="외곽선" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>
       <DockPanel><TextBlock Text="두께"/><TextBlock Text="{Binding OutlineWidth, StringFormat={}{0:0.0} px}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
       <Slider Minimum="0" Maximum="3" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding OutlineWidth}" AutomationProperties.AutomationId="OutlineWidth"/>
       <Button Command="{Binding OutlineColorCommand}"><StackPanel Orientation="Horizontal"><Border Background="{Binding OutlineColor}" Width="14" Height="14" CornerRadius="3" BorderBrush="#55514B" BorderThickness="1" Margin="0,0,10,0"/><TextBlock Text="외곽선 색상"/></StackPanel></Button>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
       <CheckBox Content="그림자" IsChecked="{Binding TextShadow}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>
       <StackPanel IsEnabled="{Binding TextShadow}">
        <DockPanel><TextBlock Text="강도"/><TextBlock Text="{Binding ShadowOpacity, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ShadowOpacity}"/>
        <DockPanel><TextBlock Text="번짐"/><TextBlock Text="{Binding ShadowBlur, StringFormat={}{0:0.0} px}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
        <Slider Minimum="0" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding ShadowBlur}"/>
        <DockPanel><TextBlock Text="거리"/><TextBlock Text="{Binding ShadowDistance, StringFormat={}{0:0.0} px}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
        <Slider Minimum="0" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding ShadowDistance}"/>
        <Button Command="{Binding ShadowColorCommand}"><StackPanel Orientation="Horizontal"><Border Background="{Binding ShadowColor}" Width="14" Height="14" CornerRadius="3" BorderBrush="#55514B" BorderThickness="1" Margin="0,0,10,0"/><TextBlock Text="그림자 색상"/></StackPanel></Button>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
       <TextBlock Text="메시지별 배경" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>
       <DockPanel><TextBlock Text="불투명도"/><TextBlock Text="{Binding MessageBackgroundOpacity, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#F18A40"/></DockPanel>
       <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MessageBackgroundOpacity}"/>
       <Button Command="{Binding MessageBackgroundColorCommand}"><StackPanel Orientation="Horizontal"><Border Background="{Binding MessageBackgroundColor}" Width="14" Height="14" CornerRadius="3" BorderBrush="#55514B" BorderThickness="1" Margin="0,0,10,0"/><TextBlock Text="메시지 배경 색상"/></StackPanel></Button>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
