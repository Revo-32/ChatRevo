<Window x:Class="ChatRevo.Desktop.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ChatRevo.Desktop.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Chat Revo" Width="1100" Height="790" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#0D0D0D" Foreground="#ECEAE6" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Icon="../Assets/Brand/ChatRevo.ico">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#32302C" BorderThickness="1" CornerRadius="10" Background="#0D0D0D">
  <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <Border Background="#181817" BorderBrush="#292724" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0"><Grid><StackPanel Orientation="Horizontal" Margin="17,0" VerticalAlignment="Center"><Image Source="../Assets/Brand/mark.png" Width="16" Height="16" Margin="0,0,10,0"/><TextBlock Text="Chat Revo" Foreground="#D0CBC3" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Style="{StaticResource WindowButton}" Click="MinimizeClick" ToolTip="최소화"/><Button Content="□" Style="{StaticResource WindowButton}" Click="MaximizeClick" ToolTip="최대화 / 복원"/><Button Content="✕" Style="{StaticResource WindowButton}" Click="CloseClick" ToolTip="트레이로 숨기기"/></StackPanel></Grid></Border>
   <TabControl x:Name="Navigation" Grid.Row="1" SelectedIndex="0" BorderThickness="0" Background="Transparent">
    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" Margin="0,0,12,0"/><TextBlock Text="오버레이"/></StackPanel></TabItem.Header>
     <ScrollViewer Foreground="#ECEAE6"><StackPanel>
      <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="오버레이" Style="{StaticResource PageTitle}"/></StackPanel></Grid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="치지직 채널" FontWeight="SemiBold" Margin="0,0,0,13"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Text="{Binding ChannelInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ChannelInput" ToolTip="치지직 채널 주소 또는 채널 ID"/><Button Grid.Column="2" Content="채팅 연결  →" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="Connect"/></Grid><DockPanel Margin="0,13,0,0"><Ellipse Fill="#E8782F" Width="5" Height="5" Margin="0,0,7,0"/><TextBlock Text="{Binding ChannelName}" Foreground="#D0CBC4"/><TextBlock Text="{Binding LiveStatus}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="20,18"><TextBlock Text="오버레이 미리보기" FontWeight="SemiBold"/><TextBlock Text="샘플 메시지" FontSize="10" Foreground="#77726A" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        <Border Grid.Row="1" Margin="16,0,16,16" CornerRadius="7" BorderBrush="#2D2924" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2C251E" Offset="0"/><GradientStop Color="#171B1C" Offset="0.6"/><GradientStop Color="#241E19" Offset="1"/></LinearGradientBrush></Border.Background><Grid MinHeight="198" Margin="22"><StackPanel VerticalAlignment="Center"><TextBlock Text="CHAT REVO" FontSize="10" Foreground="#C5804E" Margin="0,0,0,19"/><TextBlock FontSize="16" LineHeight="29"><Run Text="Revo  " Foreground="#F5934D"/><Run Text="오늘도 반가워요!"/></TextBlock><TextBlock FontSize="16" LineHeight="29"><Run Text="달빛산책  " Foreground="#B9B2D0"/><Run Text="이번 판 느낌 좋은데요"/></TextBlock><TextBlock FontSize="16" LineHeight="29"><Run Text="오늘도맑음  " Foreground="#96B6B1"/><Run Text="집중하면서 같이 봐요 ✨"/></TextBlock><Border Background="#30241A" BorderBrush="#5B3B24" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="구독 알림 예시" FontSize="10" Foreground="#E79455"/><TextBlock Text="함께하는 시간이 쌓이고 있어요." Margin="0,6,0,0" FontSize="12"/></StackPanel></Border></StackPanel></Grid></Border>
        <Button Grid.Row="2" Content="별도 창에서 미리보기  ↗" Command="{Binding PreviewCommand}" Margin="16,0,16,16" AutomationProperties.AutomationId="Preview"/>
       </Grid></Border>
       <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}" Padding="19" Margin="0,0,0,16"><StackPanel><TextBlock Text="창 컨트롤" FontWeight="SemiBold" Margin="0,0,0,16"/><Button Content="{Binding LockLabel}" Command="{Binding LockCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="Lock"/><Button Content="오버레이 표시 / 숨기기" Command="{Binding VisibilityCommand}" Margin="0,10,0,0"/><Button Content="채팅 새로고침" Command="{Binding ReloadCommand}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="19"><StackPanel><TextBlock Text="게임 중 단축키" FontWeight="SemiBold" Margin="0,0,0,15"/><TextBlock Text="잠금 전환         Ctrl + Alt + L" Foreground="#B5AEA4" FontSize="12" Margin="0,0,0,11"/><TextBlock Text="표시 전환         Ctrl + Alt + O" Foreground="#B5AEA4" FontSize="12" Margin="0,0,0,11"/><TextBlock Text="설정 열기         Ctrl + Alt + S" Foreground="#B5AEA4" FontSize="12"/></StackPanel></Border></StackPanel>
      </Grid>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE790;" Margin="0,0,12,0"/><TextBlock Text="화면 스타일"/></StackPanel></TabItem.Header>
     <views:AppearancePanel x:Name="Appearance"/>
    </TabItem>
    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77B;" Margin="0,0,12,0"/><TextBlock Text="네이버 계정"/></StackPanel></TabItem.Header>
     <StackPanel TextElement.Foreground="#ECEAE6"><TextBlock Text="네이버 계정" Style="{StaticResource PageTitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="네이버 로그인" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="네이버 공식 로그인 페이지를 엽니다." Style="{StaticResource Description}" Margin="0,14,0,22"/><WrapPanel><Button Content="네이버 로그인  ↗" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" Margin="0,0,12,0"/><Button Content="로그아웃" Command="{Binding LogoutCommand}"/></WrapPanel></StackPanel></Border><TextBlock Text="로그아웃은 Chat Revo에만 적용됩니다." Style="{StaticResource Description}" Margin="4,22,0,0"/></StackPanel>
    </TabItem>
    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" Margin="0,0,12,0"/><TextBlock Text="업데이트"/></StackPanel></TabItem.Header>
     <StackPanel TextElement.Foreground="#ECEAE6"><TextBlock Text="업데이트" Style="{StaticResource PageTitle}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="현재 버전" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Right" Foreground="#EE8D49"/></DockPanel><Border Height="1" Background="#2B2824" Margin="0,20"/><CheckBox Content="앱 시작 시 자동 확인·다운로드" IsChecked="{Binding AutoUpdate}"/><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Description}" Margin="0,20"/><WrapPanel><Button Content="업데이트 확인" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" Margin="0,0,12,0"/><Button Content="재시작하여 적용" Command="{Binding RestartCommand}"/></WrapPanel></StackPanel></Border><TextBlock Text="다운로드한 업데이트는 다음 실행 때 적용됩니다." Style="{StaticResource Description}" Margin="4,22,0,0"/></StackPanel>
    </TabItem>
   </TabControl>
   <Border Grid.Row="2" Background="#101010" BorderBrush="#252421" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10"><Grid Margin="18,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="#8E8981" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,14,0"/><Button Grid.Column="1" Content="앱 종료" Command="{Binding ExitCommand}" Padding="10,4" Background="Transparent" BorderThickness="0" Foreground="#A39D95"/></Grid></Border>
  </Grid>
 </Border>
</Window>
