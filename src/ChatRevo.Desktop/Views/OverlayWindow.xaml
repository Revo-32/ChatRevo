<Window x:Class="ChatRevo.Desktop.Views.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Chat Revo · 오버레이" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#ECEAE6" FontFamily="Segoe UI, Malgun Gothic" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False" Topmost="True" MinWidth="280" MinHeight="200">
 <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" BorderBrush="#B16A38" Background="#59101010">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="EditBar" Background="#F0201B17" Padding="12,8" MouseLeftButtonDown="DragHeader" CornerRadius="7,7,0,0" Cursor="SizeAll"><DockPanel><Button Content="잠금" DockPanel.Dock="Right" Padding="10,3" Click="LockClick"/><TextBlock Text="이동 · 크기 조절" FontSize="12" VerticalAlignment="Center" Foreground="#CDA17D"/></DockPanel></Border>
   <Border x:Name="InfoBar" Grid.Row="1" Padding="20,12,20,10" MouseLeftButtonDown="DragHeader" ToolTip="{Binding LiveStatus}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="1"/></StackPanel.Effect>
     <TextBlock x:Name="HeaderChannel" Text="{Binding ChannelName}" FontSize="22" FontWeight="Bold" Foreground="#FFA466" MaxWidth="260" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <Ellipse x:Name="LiveDot" Fill="{Binding LiveDotColor}" Width="7" Height="7" Margin="12,0,6,0" VerticalAlignment="Center"/>
     <TextBlock x:Name="HeaderCount" Text="{Binding ViewerCountText}" FontSize="16" FontWeight="SemiBold" Foreground="#F0EEEB" VerticalAlignment="Center"/>
    </StackPanel>
   </Border>
   <Grid Grid.Row="2"><wv:WebView2CompositionControl x:Name="Browser" DefaultBackgroundColor="Transparent"/><Border x:Name="ErrorPanel" Background="#E6111822" Padding="20" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock Text="채팅을 불러오지 못했습니다." FontSize="17"/><TextBlock x:Name="ErrorText" Foreground="#B6C7DA" Margin="0,10,0,14"/><Button Content="다시 연결" Click="RetryClick"/></StackPanel></Border></Grid>
  </Grid>
 </Border>
</Window>
